step "deploy-monitoring" {
    name = "Deploy Monitoring Stack"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_disabled = true
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -e
                
                echo "Current directory: $(pwd)"
                echo "Searching for monitoring directory..."
                
                # Find the monitoring directory wherever it is
                MONITORING_DIR=$(find . -type d -name "monitoring" | head -n 1)
                
                if [ -z "$MONITORING_DIR" ]; then
                    echo "ERROR: Cannot find monitoring directory"
                    echo "Directory structure:"
                    ls -laR
                    exit 1
                fi
                
                echo "Found monitoring at: $MONITORING_DIR"
                cd "$MONITORING_DIR"
                
                echo "Contents of monitoring directory:"
                ls -la
                
                # Make script executable and run
                if [ -f "deploy-monitoring.sh" ]; then
                    chmod +x deploy-monitoring.sh
                    bash deploy-monitoring.sh
                else
                    echo "ERROR: deploy-monitoring.sh not found in $(pwd)"
                    exit 1
                fi
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }

        packages "charts" {
            acquisition_location = "ExecutionTarget"
            feed = "octopus-server-built-in"
            package_id = "charts"
            properties = {
                Extract = "True"
                SelectionMode = "immediate"
            }
        }
    }
}