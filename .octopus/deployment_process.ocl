step "upsert-ecr-credentials" {
    name = "Upsert ECR Credentials"
    properties = {
        Octopus.Action.TargetRoles = "dev,k8s"
    }

    action {
        action_type = "Octopus.KubernetesRunScript"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "Upserting ECR pull secret..."
                
                # Get AWS credentials from IAM Role (Octopus runs on EC2 with IAM profile)
                ACCOUNT_ID="365074502389"
                REGION="us-east-1"
                NAMESPACE="tunefy-dev"
                
                # Get ECR login token
                TOKEN=$(aws ecr get-login-password --region $REGION)
                
                # Create or update secret
                kubectl create secret docker-registry ecr-creds \
                  --docker-server=${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com \
                  --docker-username=AWS \
                  --docker-password="$TOKEN" \
                  --namespace=$NAMESPACE \
                  --dry-run=client -o yaml | kubectl apply -f -
                
                echo "ECR credentials updated in namespace $NAMESPACE"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.RunOnServer = "false"
            OctopusUseBundledTooling = "False"
        }
    }
}

step "deploy-helm-frontend" {
    name = "Deploy Helm (Frontend)"
    properties = {
        Octopus.Action.TargetRoles = "dev,k8s"
    }

    action {
        action_type = "Octopus.HelmChartUpgrade"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "3"
            Octopus.Action.Helm.AdditionalArgs = "--atomic --timeout 5m"
            Octopus.Action.Helm.ChartDirectory = "charts/frontend"
            Octopus.Action.Helm.Namespace = "tunefy-dev"
            Octopus.Action.Helm.ReleaseName = "tunefy-frontend"
            Octopus.Action.Helm.ResetValues = "False"
            Octopus.Action.Helm.ValuesFile = "values-dev.yaml"
            Octopus.Action.Helm.ValueOverrides = <<-EOT
                image:
                  tag: "#{Octopus.Release.Number}"
                EOT
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "charts"
            Octopus.Action.Script.ScriptSource = "Package"
        }

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "charts"
            properties = {
                SelectionMode = "immediate"
                Extract = "True"
            }
        }
    }
}

step "deploy-helm-backend-colornext" {
    name = "Deploy Helm (Backend ColorNext)"
    properties = {
        Octopus.Action.TargetRoles = "dev,k8s"
    }

    action {
        action_type = "Octopus.HelmChartUpgrade"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.Helm.AdditionalArgs = "--atomic --timeout 5m"
            Octopus.Action.Helm.ChartDirectory = "charts/backend"
            Octopus.Action.Helm.Namespace = "tunefy-dev"
            Octopus.Action.Helm.ReleaseName = "tunefy-backend"
            Octopus.Action.Helm.ResetValues = "False"
            Octopus.Action.Helm.ValuesFile = "values-dev.yaml"
            Octopus.Action.Helm.ValueOverrides = <<-EOT
                image:
                  tag: "#{Octopus.Release.Number}"
                color: "#{ColorNext}"
                service:
                  selector:
                    colorLive: "#{ColorNext}"
                EOT
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.WaitForJobs = "False"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "charts"
            Octopus.Action.Script.ScriptSource = "Package"
        }

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "charts"
            properties = {
                SelectionMode = "immediate"
                Extract = "True"
            }
        }
    }
}

step "smoke-test" {
    name = "Smoke test"
    properties = {
        Octopus.Action.TargetRoles = "dev,k8s"
    }

    action {
        action_type = "Octopus.KubernetesRunScript"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "Running smoke test on backend service..."
                echo "Testing ColorNext: #{ColorNext}"
                
                # Probar el backend en el Service interno (service apunta a ColorNext)
                kubectl -n tunefy-dev run smoke-test-#{Octopus.Release.Number | Replace "[^a-z0-9-]" "-" | ToLower} \
                  --restart=Never \
                  --image=curlimages/curl:8.10.1 \
                  --rm -i \
                  -- curl -sf http://backend:3001/health
                
                echo "Smoke test passed!"
                echo "Setting ColorLive to #{ColorNext}"
                
                # Set output variable for next step
                set_octopusvariable "SmokeTestResult" "success"
                
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }
    }
}

step "update-colorlive" {
    name = "Update ColorLive"
    properties = {
        Octopus.Action.TargetRoles = "dev,k8s"
    }
    condition = "Success"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Update the ColorLive project variable
                Write-Host "Smoke test passed - Updating ColorLive"
                Write-Host "Previous ColorLive: #{ColorLive}"
                Write-Host "New ColorLive: #{ColorNext}"
                
                # This will be reflected in the next deployment
                Set-OctopusVariable -name "ColorLive" -value "#{ColorNext}"
                
                Write-Host "ColorLive updated successfully"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }
    }
}