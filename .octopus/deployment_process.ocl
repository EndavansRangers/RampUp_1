step "setup-kubeconfig" {
    name = "Setup Kubeconfig"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Setting up kubeconfig for Kubernetes access ==="
                
                # Create kubeconfig directory
                mkdir -p ~/.kube
                
                # Create kubeconfig file for the cluster
                cat > ~/.kube/config << 'KUBECONFIG_EOF'
                apiVersion: v1
                kind: Config
                clusters:
                - cluster:
                    insecure-skip-tls-verify: true
                    server: https://127.0.0.1:6443
                  name: tunefy-dev
                contexts:
                - context:
                    cluster: tunefy-dev
                    user: admin
                    namespace: tunefy-dev
                  name: tunefy-dev
                current-context: tunefy-dev
                users:
                - name: admin
                  user:
                    token: "#{Kubernetes.Token}"
                KUBECONFIG_EOF
                
                chmod 600 ~/.kube/config
                echo "✓ Kubeconfig created successfully"
                
                # Test connection
                kubectl version --client
                kubectl get nodes
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

step "upsert-ecr-credentials" {
    name = "Upsert ECR Credentials"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Upserting ECR pull secret ==="
                
                # Get AWS credentials from IAM Role (CP has IAM profile)
                ACCOUNT_ID="365074502389"
                REGION="us-east-1"
                NAMESPACE="tunefy-dev"
                
                # Get ECR login token using IAM Role
                echo "Getting ECR login token..."
                TOKEN=$(aws ecr get-login-password --region "$REGION")
                
                echo "Creating Kubernetes secret..."
                
                # Create or update secret using kubectl
                kubectl create secret docker-registry ecr-creds \
                  --docker-server=${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com \
                  --docker-username=AWS \
                  --docker-password="$TOKEN" \
                  --namespace=$NAMESPACE \
                  --dry-run=client -o yaml | kubectl apply -f -
                
                echo "✓ ECR credentials updated in namespace $NAMESPACE"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

step "deploy-helm-frontend" {
    name = "Deploy Helm (Frontend)"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "3"
            Octopus.Action.Package.DownloadOnTentacle = "True"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "charts"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Deploying Frontend Helm chart ==="
                
                RELEASE_NAME="tunefy-frontend"
                NAMESPACE="tunefy-dev"
                CHART_DIR="charts/frontend"
                IMAGE_TAG="#{Octopus.Release.Number}"
                
                # Deploy using Helm
                helm upgrade --install "$RELEASE_NAME" "$CHART_DIR" \
                  --namespace "$NAMESPACE" \
                  --set image.tag="$IMAGE_TAG" \
                  --values "$CHART_DIR/values-dev.yaml" \
                  --atomic \
                  --timeout 5m \
                  --wait
                
                echo "✓ Frontend deployed successfully"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "charts"
            properties = {
                SelectionMode = "immediate"
                Extract = "True"
            }
        }
    }
}

step "deploy-helm-backend-colornext" {
    name = "Deploy Helm (Backend ColorNext)"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.Package.DownloadOnTentacle = "True"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "charts"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Deploying Backend Helm chart (ColorNext: #{ColorNext}) ==="
                
                RELEASE_NAME="tunefy-backend"
                NAMESPACE="tunefy-dev"
                CHART_DIR="charts/backend"
                IMAGE_TAG="#{Octopus.Release.Number}"
                COLOR_NEXT="#{ColorNext}"
                
                # Deploy using Helm
                helm upgrade --install "$RELEASE_NAME" "$CHART_DIR" \
                  --namespace "$NAMESPACE" \
                  --set image.tag="$IMAGE_TAG" \
                  --set color="$COLOR_NEXT" \
                  --set service.selector.colorLive="$COLOR_NEXT" \
                  --values "$CHART_DIR/values-dev.yaml" \
                  --atomic \
                  --timeout 5m \
                  --wait
                
                echo "✓ Backend deployed successfully with color: $COLOR_NEXT"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "charts"
            properties = {
                SelectionMode = "immediate"
                Extract = "True"
            }
        }
    }
}

step "smoke-test" {
    name = "Smoke test"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Running smoke test on backend service ==="
                echo "Testing ColorNext: #{ColorNext}"
                
                NAMESPACE="tunefy-dev"
                POD_NAME="smoke-test-$(date +%s)"
                
                # Run smoke test using kubectl
                kubectl run "$POD_NAME" \
                  --namespace="$NAMESPACE" \
                  --restart=Never \
                  --image=curlimages/curl:8.10.1 \
                  --rm -i \
                  -- curl -sf http://backend:3001/health
                
                echo "✓ Smoke test passed!"
                echo "ColorLive can be set to #{ColorNext}"
                
                # Set output variable for next step
                set_octopusvariable "SmokeTestResult" "success"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

step "update-colorlive" {
    name = "Update ColorLive"
    condition = "Success"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Update the ColorLive project variable
                Write-Host "Smoke test passed - Updating ColorLive"
                Write-Host "Previous ColorLive: #{ColorLive}"
                Write-Host "New ColorLive: #{ColorNext}"
                
                # This will be reflected in the next deployment
                Set-OctopusVariable -name "ColorLive" -value "#{ColorNext}"
                
                Write-Host "ColorLive updated successfully"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
    }
}
