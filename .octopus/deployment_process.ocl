step "smoke-test" {
    name = "Smoke test"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Running smoke test on backend service ==="
                echo "Testing ColorNext: #{ColorNext}"
                
                NAMESPACE="tunefy-dev"
                POD_NAME="smoke-test-$(date +%s)"
                
                # Run smoke test using kubectl
                kubectl run "$POD_NAME" \
                  --namespace="$NAMESPACE" \
                  --restart=Never \
                  --image=curlimages/curl:8.10.1 \
                  --rm -i \
                  -- curl -sf http://backend:3001/health
                
                echo "✓ Smoke test passed!"
                echo "ColorLive can be set to #{ColorNext}"
                
                # Set output variable for next step
                set_octopusvariable "SmokeTestResult" "success"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

