step "setup-kubeconfig" {
    name = "Setup Kubeconfig"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Setting up kubeconfig for Kubernetes access ==="
                
                # Create kubeconfig directory
                mkdir -p ~/.kube
                
                # Create kubeconfig file for the cluster
                cat > ~/.kube/config << 'KUBECONFIG_EOF'
                apiVersion: v1
                kind: Config
                clusters:
                - cluster:
                    insecure-skip-tls-verify: true
                    server: https://127.0.0.1:6443
                  name: tunefy-dev
                contexts:
                - context:
                    cluster: tunefy-dev
                    user: octopus-deploy
                    namespace: tunefy-dev
                  name: tunefy-dev
                current-context: tunefy-dev
                users:
                - name: octopus-deploy
                  user:
                    token: "#{Kubernetes.Token}"
                KUBECONFIG_EOF
                
                chmod 600 ~/.kube/config
                echo "✓ Kubeconfig created successfully"
                
                # Test connection
                kubectl version --client
                kubectl get nodes
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

step "upsert-ecr-credentials" {
    name = "Upsert ECR Credentials"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Upserting ECR pull secret ==="
                
                # Get AWS credentials from IAM Role (CP has IAM profile)
                ACCOUNT_ID="638325785916"
                REGION="us-east-1"
                NAMESPACE="tunefy-dev"
                
                # Get ECR login token using IAM Role
                echo "Getting ECR login token..."
                TOKEN=$(aws ecr get-login-password --region "$REGION")
                
                echo "Creating Kubernetes secret..."
                
                # Create or update secret using kubectl
                kubectl create secret docker-registry ecr-creds \
                  --docker-server=${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com \
                  --docker-username=AWS \
                  --docker-password="$TOKEN" \
                  --namespace=$NAMESPACE \
                  --dry-run=client -o yaml | kubectl apply -f -
                
                echo "✓ ECR credentials updated in namespace $NAMESPACE"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

step "cleanup-resources" {
    name = "Cleanup Old Resources"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        notes = "Clean up old ReplicaSets and stuck pods to free memory"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Pre-deployment Health Check ==="
                NAMESPACE="tunefy-dev"
                
                # Check if worker nodes are Ready
                echo "Checking worker node status..."
                WORKER_READY=$(kubectl get nodes --no-headers | grep -v "control-plane" | awk '{print $2}' | grep -c "Ready" || echo "0")
                if [ "$WORKER_READY" -eq 0 ]; then
                    echo "WARNING: No worker nodes are Ready. Waiting 30 seconds..."
                    sleep 30
                fi
                
                echo "=== Cleaning up old resources ==="
                
                # Delete old ReplicaSets (keep only active ones)
                echo "Deleting old ReplicaSets..."
                for rs in $(kubectl get replicaset -n $NAMESPACE --no-headers | awk '$2==0 && $3==0 && $4==0 {print $1}'); do
                    kubectl delete replicaset $rs -n $NAMESPACE --ignore-not-found=true
                done
                
                # Delete stuck pods (Terminating, Pending with errors, Failed, Error, etc.)
                echo "Deleting stuck pods..."
                kubectl delete pod --field-selector status.phase=Failed -n $NAMESPACE --force --grace-period=0 --ignore-not-found=true || true
                kubectl delete pod --field-selector status.phase=Unknown -n $NAMESPACE --force --grace-period=0 --ignore-not-found=true || true
                
                # Delete old smoke test pods
                kubectl delete pod -n $NAMESPACE -l job-name --field-selector status.phase=Succeeded --ignore-not-found=true || true
                kubectl delete pod -n $NAMESPACE -l job-name --field-selector status.phase=Failed --ignore-not-found=true || true
                
                # Force delete any pods stuck in Terminating for more than 5 minutes
                echo "Checking for long-running Terminating pods..."
                # Get pods in Terminating state (simpler approach without jq)
                kubectl get pods -n $NAMESPACE --field-selector status.phase=Terminating --no-headers 2>/dev/null | \
                  awk '{print $1}' | \
                  xargs -r kubectl delete pod -n $NAMESPACE --force --grace-period=0 --ignore-not-found=true || true
                
                # NUEVO: Eliminar pods de color inactivo (blue/green)
                echo "Deleting pods from inactive color (blue/green optimization)..."
                CURRENT_COLOR=$(kubectl get service backend -n $NAMESPACE -o jsonpath='{.spec.selector.colorLive}' 2>/dev/null || echo "unknown")
                if [ "$CURRENT_COLOR" != "unknown" ] && [ "$CURRENT_COLOR" != "true" ] && [ "$CURRENT_COLOR" != "false" ]; then
                    INACTIVE_COLOR=$([ "$CURRENT_COLOR" = "blue" ] && echo "green" || echo "blue")
                    echo "Current live color: $CURRENT_COLOR, deleting $INACTIVE_COLOR pods..."
                    kubectl delete pods -n $NAMESPACE -l color=$INACTIVE_COLOR --force --grace-period=0 --ignore-not-found=true || true
                else
                    echo "Skipping color cleanup (colorLive not set or invalid: $CURRENT_COLOR)"
                fi
                
                # NUEVO: Verificar espacio en disco (warning si hay muchas imágenes)
                echo "Checking disk space and image cache..."
                # Count images without jq
                IMAGE_COUNT=$(kubectl get nodes -o jsonpath='{.items[*].status.images[*].names[0]}' 2>/dev/null | wc -w || echo "0")
                echo "Worker has approximately $IMAGE_COUNT images cached"
                if [ "$IMAGE_COUNT" -gt 50 ]; then
                    echo "⚠️  WARNING: Many images cached ($IMAGE_COUNT), node may be low on disk space"
                    echo "Consider cleaning up: crictl rmi --prune on the worker node"
                fi
                
                echo "✓ Cleanup completed"
                # AUMENTADO: Esperar más tiempo para que recursos se liberen
                echo "Waiting for resources to be fully freed..."
                sleep 10
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

