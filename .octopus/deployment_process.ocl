step "smoke-test" {
    name = "Smoke test"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Running smoke test on backend service ==="
                echo "Testing ColorNext: #{ColorNext}"
                
                NAMESPACE="tunefy-dev"
                POD_NAME="smoke-test-$(date +%s)"
                
                # Run smoke test using kubectl (without --rm to avoid deletion issues)
                # Use direct IP to avoid DNS resolution issues
                BACKEND_IP=$(kubectl get svc backend -n "$NAMESPACE" -o jsonpath='{.spec.clusterIP}')
                kubectl run "$POD_NAME" \
                  --namespace="$NAMESPACE" \
                  --restart=Never \
                  --image=curlimages/curl:8.10.1 \
                  -- curl -sf http://$BACKEND_IP:3001/health
                
                # Wait for pod to complete
                echo "Waiting for smoke test to complete..."
                kubectl wait --for=condition=Ready pod/"$POD_NAME" -n "$NAMESPACE" --timeout=30s || true
                sleep 2
                
                # Get the result
                RESULT=$(kubectl logs "$POD_NAME" -n "$NAMESPACE" 2>/dev/null || echo "failed")
                
                # Clean up the pod (best effort, don't fail if it doesn't work)
                kubectl delete pod "$POD_NAME" -n "$NAMESPACE" --ignore-not-found=true --wait=false || true
                
                # Check if the result contains "healthy"
                if echo "$RESULT" | grep -q "healthy"; then
                    echo "✓ Smoke test passed!"
                    echo "$RESULT"
                    echo "ColorLive can be set to #{ColorNext}"
                    set_octopusvariable "SmokeTestResult" "success"
                else
                    echo "✗ Smoke test failed!"
                    echo "$RESULT"
                    exit 1
                fi
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

