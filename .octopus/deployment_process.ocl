step "setup-kubeconfig" {
    name = "Setup Kubeconfig"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Installing kubectl if not available ==="
                if ! command -v kubectl &> /dev/null; then
                    echo "Installing kubectl..."
                    curl -LO "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl"
                    chmod +x kubectl
                    export PATH="$PATH:$PWD"
                    echo "kubectl installed in current directory"
                else
                    echo "kubectl already available: $(kubectl version --client --short 2>/dev/null || kubectl version --client)"
                fi
                
                echo ""
                echo "Setting up kubeconfig for Kubernetes access..."
                
                # Create kubeconfig directory
                mkdir -p ~/.kube
                
                # Create kubeconfig file for the cluster
                cat > ~/.kube/config << 'KUBECONFIG_EOF'
                apiVersion: v1
                kind: Config
                clusters:
                - cluster:
                    insecure-skip-tls-verify: true
                    server: https://tunefy-dev-cp-nlb-c77324b383d150a0.elb.us-east-1.amazonaws.com
                  name: tunefy-dev
                contexts:
                - context:
                    cluster: tunefy-dev
                    user: admin
                    namespace: tunefy-dev
                  name: tunefy-dev
                current-context: tunefy-dev
                users:
                - name: admin
                  user:
                    token: "#{Kubernetes.Token}"
                KUBECONFIG_EOF
                
                chmod 600 ~/.kube/config
                echo "Kubeconfig created successfully"
                
                # Test connection using kubectl
                ./kubectl version --short 2>/dev/null || kubectl version --short || echo "kubectl connection test - will verify in next steps"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.RunOnServer = "true"
        }
    }
}

step "upsert-ecr-credentials" {
    name = "Upsert ECR Credentials"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Ensuring tools are available ==="
                
                # Install kubectl if not available
                if ! command -v kubectl &> /dev/null; then
                    if [ ! -f ./kubectl ]; then
                        echo "Installing kubectl..."
                        curl -LO "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                    fi
                    export PATH="$PATH:$PWD"
                fi
                
                # Install AWS CLI if not available (without sudo)
                if ! command -v aws &> /dev/null; then
                    echo "Installing AWS CLI..."
                    curl -s "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
                    unzip -q awscliv2.zip 2>/dev/null || {
                        echo "unzip not available, extracting manually..."
                        # Try python if available
                        python3 -m zipfile -e awscliv2.zip . 2>/dev/null || {
                            echo "Cannot extract AWS CLI, using pre-installed version"
                            export PATH="/usr/local/bin:$PATH"
                        }
                    }
                    if [ -d ./aws ]; then
                        ./aws/install --bin-dir $PWD/aws-bin --install-dir $PWD/aws-cli || {
                            echo "Using pre-installed AWS CLI"
                        }
                        export PATH="$PWD/aws-bin:$PATH"
                        rm -rf aws awscliv2.zip
                    fi
                fi
                
                echo ""
                echo "Upserting ECR pull secret..."
                
                # Get AWS credentials from IAM Role (Octopus runs on EC2 with IAM profile)
                ACCOUNT_ID="365074502389"
                REGION="us-east-1"
                NAMESPACE="tunefy-dev"
                
                # Get ECR login token using IAM Role
                TOKEN=$(aws ecr get-login-password --region "$REGION")
                
                # Create or update secret using kubectl
                kubectl create secret docker-registry ecr-creds \
                  --docker-server=${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com \
                  --docker-username=AWS \
                  --docker-password="$TOKEN" \
                  --namespace=$NAMESPACE \
                  --dry-run=client -o yaml | kubectl apply -f -
                
                echo "ECR credentials updated in namespace $NAMESPACE"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.RunOnServer = "true"
        }
    }
}

step "deploy-helm-frontend" {
    name = "Deploy Helm (Frontend)"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "3"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "charts"
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Ensuring tools are available ==="
                
                # Install kubectl if not available
                if ! command -v kubectl &> /dev/null; then
                    if [ ! -f ./kubectl ]; then
                        curl -LO "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                    fi
                    export PATH="$PATH:$PWD"
                fi
                
                # Install helm if not available
                if ! command -v helm &> /dev/null; then
                    if [ ! -f ./helm ]; then
                        echo "Installing helm..."
                        curl -fsSL https://get.helm.sh/helm-v3.13.1-linux-amd64.tar.gz | tar xz
                        mv linux-amd64/helm ./helm
                        rm -rf linux-amd64
                        chmod +x helm
                    fi
                    export PATH="$PATH:$PWD"
                fi
                
                echo ""
                echo "Deploying Frontend Helm chart..."
                
                RELEASE_NAME="tunefy-frontend"
                NAMESPACE="tunefy-dev"
                CHART_DIR="charts/frontend"
                IMAGE_TAG="#{Octopus.Release.Number}"
                
                # Deploy using Helm
                helm upgrade --install "$RELEASE_NAME" "$CHART_DIR" \
                  --namespace "$NAMESPACE" \
                  --set image.tag="$IMAGE_TAG" \
                  --values "$CHART_DIR/values-dev.yaml" \
                  --atomic \
                  --timeout 5m \
                  --wait
                
                echo "Frontend deployed successfully"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "charts"
            properties = {
                SelectionMode = "immediate"
                Extract = "True"
            }
        }
    }
}

step "deploy-helm-backend-colornext" {
    name = "Deploy Helm (Backend ColorNext)"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "charts"
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Ensuring tools are available ==="
                
                # Install kubectl if not available
                if ! command -v kubectl &> /dev/null; then
                    if [ ! -f ./kubectl ]; then
                        curl -LO "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                    fi
                    export PATH="$PATH:$PWD"
                fi
                
                # Install helm if not available
                if ! command -v helm &> /dev/null; then
                    if [ ! -f ./helm ]; then
                        echo "Installing helm..."
                        curl -fsSL https://get.helm.sh/helm-v3.13.1-linux-amd64.tar.gz | tar xz
                        mv linux-amd64/helm ./helm
                        rm -rf linux-amd64
                        chmod +x helm
                    fi
                    export PATH="$PATH:$PWD"
                fi
                
                echo ""
                echo "Deploying Backend Helm chart (ColorNext: #{ColorNext})..."
                
                RELEASE_NAME="tunefy-backend"
                NAMESPACE="tunefy-dev"
                CHART_DIR="charts/backend"
                IMAGE_TAG="#{Octopus.Release.Number}"
                COLOR_NEXT="#{ColorNext}"
                
                # Deploy using Helm
                helm upgrade --install "$RELEASE_NAME" "$CHART_DIR" \
                  --namespace "$NAMESPACE" \
                  --set image.tag="$IMAGE_TAG" \
                  --set color="$COLOR_NEXT" \
                  --set service.selector.colorLive="$COLOR_NEXT" \
                  --values "$CHART_DIR/values-dev.yaml" \
                  --atomic \
                  --timeout 5m \
                  --wait
                
                echo "Backend deployed successfully with color: $COLOR_NEXT"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "charts"
            properties = {
                SelectionMode = "immediate"
                Extract = "True"
            }
        }
    }
}

step "smoke-test" {
    name = "Smoke test"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Ensuring kubectl is available ==="
                if ! command -v kubectl &> /dev/null; then
                    if [ ! -f ./kubectl ]; then
                        curl -LO "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                    fi
                    export PATH="$PATH:$PWD"
                fi
                
                echo ""
                echo "Running smoke test on backend service..."
                echo "Testing ColorNext: #{ColorNext}"
                
                NAMESPACE="tunefy-dev"
                POD_NAME="smoke-test-$(date +%s)"
                
                # Run smoke test using kubectl
                kubectl run "$POD_NAME" \
                  --namespace="$NAMESPACE" \
                  --restart=Never \
                  --image=curlimages/curl:8.10.1 \
                  --rm -i \
                  -- curl -sf http://backend:3001/health
                
                echo "Smoke test passed!"
                echo "Setting ColorLive to #{ColorNext}"
                
                # Set output variable for next step
                set_octopusvariable "SmokeTestResult" "success"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "update-colorlive" {
    name = "Update ColorLive"
    condition = "Success"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Update the ColorLive project variable
                Write-Host "Smoke test passed - Updating ColorLive"
                Write-Host "Previous ColorLive: #{ColorLive}"
                Write-Host "New ColorLive: #{ColorNext}"
                
                # This will be reflected in the next deployment
                Set-OctopusVariable -name "ColorLive" -value "#{ColorNext}"
                
                Write-Host "ColorLive updated successfully"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
    }
}
