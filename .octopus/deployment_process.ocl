step "setup-kubeconfig" {
    name = "Setup Kubeconfig"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Setting up kubeconfig for Kubernetes access ==="
                
                # Create kubeconfig directory
                mkdir -p ~/.kube
                
                # Create kubeconfig file for the cluster
                cat > ~/.kube/config << 'KUBECONFIG_EOF'
                apiVersion: v1
                kind: Config
                clusters:
                - cluster:
                    insecure-skip-tls-verify: true
                    server: https://127.0.0.1:6443
                  name: tunefy-dev
                contexts:
                - context:
                    cluster: tunefy-dev
                    user: admin
                    namespace: tunefy-dev
                  name: tunefy-dev
                current-context: tunefy-dev
                users:
                - name: admin
                  user:
                    token: "#{Kubernetes.Token}"
                KUBECONFIG_EOF
                
                chmod 600 ~/.kube/config
                echo "✓ Kubeconfig created successfully"
                
                # Test connection
                kubectl version --client
                kubectl get nodes
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

step "upsert-ecr-credentials" {
    name = "Upsert ECR Credentials"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Upserting ECR pull secret ==="
                
                # Get AWS credentials from IAM Role (CP has IAM profile)
                ACCOUNT_ID="365074502389"
                REGION="us-east-1"
                NAMESPACE="tunefy-dev"
                
                # Get ECR login token using IAM Role
                echo "Getting ECR login token..."
                TOKEN=$(aws ecr get-login-password --region "$REGION")
                
                echo "Creating Kubernetes secret..."
                
                # Create or update secret using kubectl
                kubectl create secret docker-registry ecr-creds \
                  --docker-server=${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com \
                  --docker-username=AWS \
                  --docker-password="$TOKEN" \
                  --namespace=$NAMESPACE \
                  --dry-run=client -o yaml | kubectl apply -f -
                
                echo "✓ ECR credentials updated in namespace $NAMESPACE"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

step "deploy-helm-frontend" {
    name = "Deploy Helm (Frontend)"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "3"
            Octopus.Action.Package.DownloadOnTentacle = "True"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "charts"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = "#!/bin/bash\nset -euo pipefail\n\necho \"=== Deploying Frontend Helm chart ===\"\n\nRELEASE_NAME=\"tunefy-frontend\"\nNAMESPACE=\"tunefy-dev\"\n# Use Octopus package extraction path\nPACKAGE_PATH=\"#{Octopus.Action.Package[charts].ExtractedPath}\"\nCHART_DIR=\"$PACKAGE_PATH/charts/frontend\"\nIMAGE_TAG=\"#{Octopus.Release.Number}\"\n\necho \"Package extracted to: $PACKAGE_PATH\"\necho \"Chart directory: $CHART_DIR\"\n\n# Verify chart exists\nif [ ! -f \"$CHART_DIR/Chart.yaml\" ]; then\n    echo \"ERROR: Chart.yaml not found at $CHART_DIR\"\n    echo \"Listing package contents:\"\n    ls -la \"$PACKAGE_PATH\" || true\n    ls -la \"$PACKAGE_PATH/charts\" || true\n    exit 1\nfi\n\n# Deploy using Helm\nhelm upgrade --install \"$RELEASE_NAME\" \"$CHART_DIR\" \\\n  --namespace \"$NAMESPACE\" \\\n  --create-namespace \\\n  --set image.tag=\"$IMAGE_TAG\" \\\n  --values \"$CHART_DIR/values-dev.yaml\" \\\n  --atomic \\\n  --timeout 5m \\\n  --wait\n\necho \"✓ Frontend deployed successfully\""
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }

        packages {
            acquisition_location = "ExecutionTarget"
            feed = "octopus-server-built-in"
            package_id = "charts"
            properties = {
                SelectionMode = "immediate"
                Extract = "True"
            }
        }
    }
}

step "deploy-helm-backend-colornext" {
    name = "Deploy Helm (Backend ColorNext)"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.Package.DownloadOnTentacle = "True"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "charts"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = "#!/bin/bash\nset -euo pipefail\n\necho \"=== Deploying Backend Helm chart (ColorNext: #{ColorNext}) ===\"\n\nRELEASE_NAME=\"tunefy-backend\"\nNAMESPACE=\"tunefy-dev\"\n# Use Octopus package extraction path\nPACKAGE_PATH=\"#{Octopus.Action.Package[charts].ExtractedPath}\"\nCHART_DIR=\"$PACKAGE_PATH/charts/backend\"\nIMAGE_TAG=\"#{Octopus.Release.Number}\"\nCOLOR_NEXT=\"#{ColorNext}\"\n\necho \"Package extracted to: $PACKAGE_PATH\"\necho \"Chart directory: $CHART_DIR\"\n\n# Verify chart exists\nif [ ! -f \"$CHART_DIR/Chart.yaml\" ]; then\n    echo \"ERROR: Chart.yaml not found at $CHART_DIR\"\n    echo \"Listing package contents:\"\n    ls -la \"$PACKAGE_PATH\" || true\n    ls -la \"$PACKAGE_PATH/charts\" || true\n    exit 1\nfi\n\n# Deploy using Helm\nhelm upgrade --install \"$RELEASE_NAME\" \"$CHART_DIR\" \\\n  --namespace \"$NAMESPACE\" \\\n  --create-namespace \\\n  --set image.tag=\"$IMAGE_TAG\" \\\n  --set color=\"$COLOR_NEXT\" \\\n  --set service.selector.colorLive=\"$COLOR_NEXT\" \\\n  --values \"$CHART_DIR/values-dev.yaml\" \\\n  --atomic \\\n  --timeout 5m \\\n  --wait\n\necho \"✓ Backend deployed successfully with color: $COLOR_NEXT\""
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }

        packages {
            acquisition_location = "ExecutionTarget"
            feed = "octopus-server-built-in"
            package_id = "charts"
            properties = {
                SelectionMode = "immediate"
                Extract = "True"
            }
        }
    }
}

step "smoke-test" {
    name = "Smoke test"
    properties = {
        Octopus.Action.TargetRoles = "k8s-deployer"
    }

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.AutoRetry.MaximumCount = "3"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/bin/bash
                set -euo pipefail
                
                echo "=== Running smoke test on backend service ==="
                echo "Testing ColorNext: #{ColorNext}"
                
                NAMESPACE="tunefy-dev"
                POD_NAME="smoke-test-$(date +%s)"
                
                # Run smoke test using kubectl
                kubectl run "$POD_NAME" \
                  --namespace="$NAMESPACE" \
                  --restart=Never \
                  --image=curlimages/curl:8.10.1 \
                  --rm -i \
                  -- curl -sf http://backend:3001/health
                
                echo "✓ Smoke test passed!"
                echo "ColorLive can be set to #{ColorNext}"
                
                # Set output variable for next step
                set_octopusvariable "SmokeTestResult" "success"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.TargetRoles = "k8s-deployer"
        }
    }
}

step "update-colorlive" {
    name = "Update ColorLive"

    action {
        action_type = "Octopus.Script"
        environments = ["dev"]
        is_required = true
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Update the ColorLive project variable
                Write-Host "Smoke test passed - Updating ColorLive"
                Write-Host "Previous ColorLive: #{ColorLive}"
                Write-Host "New ColorLive: #{ColorNext}"
                
                # This will be reflected in the next deployment
                Set-OctopusVariable -name "ColorLive" -value "#{ColorNext}"
                
                Write-Host "ColorLive updated successfully"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
    }
}