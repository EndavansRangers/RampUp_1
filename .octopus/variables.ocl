variable "ColorLive" {
    value "blue" {
        description = "Current active color (blue/green)"
        environment = ["dev"]
    }
}

variable "ColorNext" {
    value "blue" {
        environment = ["dev"]

        prompt {
            description = "Color to deploy (blue/green) - will be swapped after successful smoke test"
            display_settings = {
                Octopus.ControlType = "SingleLineText"
            }
            label = "Deployment Color"
        }
    }
}

variable "Kubernetes.Token" {
    value "API-A6SAZHEGARJMOTETBZIUTQ780PGE2XE" {
        description = "Kubernetes authentication token for cluster access"
        environment = ["dev"]
    }
}