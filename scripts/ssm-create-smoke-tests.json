{
  "commands": [
    "sudo -u ubuntu mkdir -p /opt/tunefy/scripts",
    "sudo -u ubuntu tee /opt/tunefy/scripts/smoke-tests-prod.sh > /dev/null << 'EOFSCRIPT'",
    "#!/bin/bash",
    "set -e",
    "",
    "COLOR=$1",
    "NAMESPACE=${2:-default}",
    "",
    "if [ -z \"$COLOR\" ]; then",
    "  echo \"Usage: $0 blue_or_green [namespace]\"",
    "  exit 1",
    "fi",
    "",
    "echo \"🧪 Running smoke tests for color: $COLOR\"",
    "",
    "POD_NAME=$(kubectl get pods -n $NAMESPACE -l app=tunefy-backend,color=$COLOR -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)",
    "",
    "if [ -z \"$POD_NAME\" ]; then",
    "  echo \"❌ ERROR: No pods found\"",
    "  exit 1",
    "fi",
    "",
    "echo \"📦 Testing pod: $POD_NAME\"",
    "echo \"Test 1: Health Check...\"",
    "HEALTH=$(kubectl exec -n $NAMESPACE $POD_NAME -- curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001/health 2>/dev/null)",
    "",
    "if [ \"$HEALTH\" != \"200\" ]; then",
    "  echo \"❌ FAILED: Health returned $HEALTH\"",
    "  exit 1",
    "fi",
    "echo \"✅ PASSED: Health check\"",
    "",
    "echo \"Test 2: Playlist Endpoint...\"",
    "PLAYLIST=$(kubectl exec -n $NAMESPACE $POD_NAME -- curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001/api/playlist?sessionId=test 2>/dev/null)",
    "",
    "if [ \"$PLAYLIST\" != \"200\" ]; then",
    "  echo \"❌ FAILED: Playlist returned $PLAYLIST\"",
    "  exit 1",
    "fi",
    "echo \"✅ PASSED: Playlist endpoint\"",
    "",
    "echo \"🎉 All smoke tests passed\"",
    "exit 0",
    "EOFSCRIPT",
    "sudo chmod +x /opt/tunefy/scripts/smoke-tests-prod.sh",
    "ls -la /opt/tunefy/scripts/"
  ]
}
