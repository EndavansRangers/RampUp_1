# ============================================
# Tunefy Production Compute Configuration
# For NEW AWS Account (Free Tier)
# ============================================
# Copy this file to terraform.tfvars and fill with your values

project = "tunefy"
region  = "us-east-1"
env     = "prod"

# VPC and Subnets (from network module outputs)
# Run: cd ../network && terraform output
vpc_id = "vpc-xxxxxxxxx"  # Replace with actual VPC ID

public_subnet_ids = [
  "subnet-xxxxxxxxx",  # us-east-1a
  "subnet-yyyyyyyyy"   # us-east-1b
]

private_subnet_ids = [
  "subnet-aaaaaaaaa",  # us-east-1a
  "subnet-bbbbbbbbb"   # us-east-1b
]

# SSH Key (create this first in AWS Console or via CLI)
key_name = "tunefy-prod-key"

# Security - Your public IP for SSH access
# Find your IP: curl ifconfig.me
allowed_ssh_cidr = "YOUR.PUBLIC.IP.HERE/32"

# Kubernetes
cluster_name = "tunefy-prod"

# Instance Types (Production)
# c7i-flex.large: 2 vCPU, 4GB RAM (both CP and Workers)
# t3.micro: Bastion (minimal resources needed)
cp_instance_type      = "c7i-flex.large"
wk_instance_type      = "c7i-flex.large"
bastion_instance_type = "t3.micro"

# IAM (from platform module outputs)
# Run: cd ../platform && terraform output
nodes_instance_profile_name = "tunefy-prod-nodes"

# ============================================
# CI/CD Cross-Account Configuration
# ============================================

# Octopus Tentacle Instance Type
tentacle_instance_type = "c7i-flex.large"  # CD Worker: 2 vCPU / 4GB RAM

# ⚠️ OCTOPUS CONFIGURATION - REQUIRED
# Get these values from your Octopus Deploy server in Dev account (638325785916)

# Octopus Server URL - IMPORTANT: Use port 8080 (API port), NOT 10943
# Port 8080: Octopus Web UI and API
# Port 10943: Octopus Tentacle polling communication (configured separately)
# Example: http://10.20.63.199:8080 (private IP) or https://octopus.example.com
octopus_server_url = "http://10.20.63.199:8080"

# Octopus API Key
# Create in Octopus UI: Profile > My API Keys > New API Key
# Needs permissions: EnvironmentView, MachineCreate, WorkerCreate
octopus_api_key = "API-XXXXXXXXXXXXXXXXXXXXXXXX"  # ⚠️ Keep this secret!

# Octopus Space (typically "Default" unless you have multiple spaces)
octopus_space = "Default"

# Additional tags
tags = {
  Owner       = "DevOps"
  Environment = "Production"
  ManagedBy   = "Terraform"
  Project     = "Tunefy"
  CostCenter  = "Engineering"
}

